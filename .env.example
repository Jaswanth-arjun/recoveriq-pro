# ============ RecoverIQ Pro — Environment Configuration ============
# Copy to .env and fill in. ANY missing key => that channel runs in
# SIMULATED mode and is labeled "SIMULATED" in the UI. Never faked.

# --- Razorpay (TEST MODE keys — free, from dashboard.razorpay.com) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# --- LLM (pick ONE; primary Anthropic Claude) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Free fallback (optional): Google Gemini free tier
GEMINI_API_KEY=
# LLM_UNAVAILABLE=true forces deterministic rule-based mode (demo of graceful failure)
LLM_UNAVAILABLE=false

# --- Voice (Gnani AI — required for the voice-recovery demo) ---
# Get a key from https://app.gnani.ai/voice  (docs: https://docs.gnani.ai)
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
# Timbre v2.5 = 42 voices (one preferred language each); v3.0 = 13 multilingual voices
GNANI_TTS_MODEL=timbre-v2.5
# Optional override. Leave blank to auto-pick: te-IN=Suhana, hi-IN=Nalini,
# en-IN=Kaveri, hi-en=Poorvi
GNANI_TTS_VOICE=
GNANI_TTS_SPEED=1.0
# Prisma v3.0 supports automatic Indian-language detection
GNANI_STT_MODEL=prisma-v3.0
# gnani | elevenlabs | none
VOICE_PROVIDER=gnani

# --- Optional legacy ElevenLabs fallback (not needed if Gnani is configured) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Telephony (Twilio places the actual phone call; Gnani supplies the voice) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# --- Messaging (optional; missing => SIMULATED) ---
RESEND_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# --- Infrastructure ---
DATABASE_URL=postgresql+asyncpg://recoveriq:recoveriq@db:5432/recoveriq
REDIS_URL=redis://redis:6379/0
SENTRY_DSN=
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
